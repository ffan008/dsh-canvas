{
  "name": "@local/dsh-canvas",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：在对话窗口里直接渲染可交互的流程图、看板与 SVG 图表",
  "type": "module",
  "main": "dsh/host.js",
  "exports": {
    ".": "./dsh/host.js",
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "files": [
    "dsh"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "canvas",
    "diagram"
  ],
  "license": "MIT"
}
